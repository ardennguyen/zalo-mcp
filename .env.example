# Zalo Official Account (OA) Credentials
# Fill these in if you want to connect to a Zalo OA
# ZALO_OA_APP_ID=
# ZALO_OA_SECRET=

# Server Port Configurations
ZALO_OA_WEBHOOK_PORT=3000
ZALO_MCP_HTTP_PORT=3847

# Storage Directories (Optional — defaults to ~/.zalo-agent-cli and ~/.zalo-agent)
# Uncomment to separate config, credentials, SQLite database, and media onto different mounts:
# ZALO_CONFIG_DIR=
# ZALO_CREDENTIALS_DIR=
# ZALO_DATA_DIR=
# ZALO_MEDIA_DIR=
# ZALO_OA_DIR=
