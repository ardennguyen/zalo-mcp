# ============================================================================
# zalo-mcp — Wrapper Port Configuration (.env.example)
# ============================================================================
# Keep this file (`zalo-mcp/.env`) for PORT settings only.
# Put storage directory overrides (`ZALO_CREDENTIALS_DIR`, `ZALO_DATA_DIR`,
# `ZALO_MEDIA_DIR`, `ZALO_OA_DIR`) and engine settings in `~/.zalo-agent-cli/.env`
# (`<CONFIG_DIR>/.env`) so `zalo-mcp` and `zalo-agent` share a single source of truth.

# Server Port Configurations
ZALO_OA_WEBHOOK_PORT=3000
ZALO_MCP_HTTP_PORT=3847

